<?xml version="1.0"?>

<robot name="ugv">

    <!-- ==================== -->
    <!-- Materials             -->
    <!-- ==================== -->

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>


    <!-- ==================== -->
    <!-- Main chassis          -->
    <!-- ==================== -->

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <box size="0.8 0.5 0.2"/>
            </geometry>

            <material name="grey"/>
        </visual>
    </link>


    <!-- ==================== -->
    <!-- Front left wheel      -->
    <!-- ==================== -->

    <link name="front_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>

            <material name="black"/>
        </visual>
    </link>


    <joint name="front_left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_left_wheel"/>

        <origin xyz="0.25 0.29 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ==================== -->
    <!-- Front right wheel     -->
    <!-- ==================== -->

    <link name="front_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>

            <material name="black"/>
        </visual>
    </link>


    <joint name="front_right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="front_right_wheel"/>

        <origin xyz="0.25 -0.29 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ==================== -->
    <!-- Rear left wheel       -->
    <!-- ==================== -->

    <link name="rear_left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>

            <material name="black"/>
        </visual>
    </link>


    <joint name="rear_left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_left_wheel"/>

        <origin xyz="-0.25 0.29 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ==================== -->
    <!-- Rear right wheel      -->
    <!-- ==================== -->

    <link name="rear_right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.12" length="0.08"/>
            </geometry>

            <material name="black"/>
        </visual>
    </link>


    <joint name="rear_right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="rear_right_wheel"/>

        <origin xyz="-0.25 -0.29 -0.02" rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


</robot>